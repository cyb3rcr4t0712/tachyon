<Window x:Class="MftSearchWpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MftSearchWpf"
        xmlns:vm="clr-namespace:MftSearchWpf.ViewModels"
        mc:Ignorable="d"
        Name="RootWindow"
        Title="Tachyon" Height="600" Width="900"
        Background="#1e1e1e" Foreground="White" WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded"
        Closing="Window_Closing">

    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>


        <!-- Search row: 2-column Grid so TextBox truly fills all space left of the button -->
        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Inner Grid overlays TextBox + placeholder in the same cell -->
            <Grid Grid.Column="0">
                <TextBox x:Name="SearchBox"
                         Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                         FontSize="24" Padding="10,0,10,0"
                         HorizontalAlignment="Stretch"
                         VerticalContentAlignment="Center"
                         Background="#2d2d30" Foreground="White"
                         BorderBrush="#555860" BorderThickness="1"
                         CaretBrush="White"
                         IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}, FallbackValue=True}"
                         GotFocus="SearchBox_GotFocus"
                         LostFocus="SearchBox_LostFocus" />
                <!-- Placeholder sits on top of the TextBox, hidden once text exists -->
                <TextBlock x:Name="SearchPlaceholder"
                           Text="Type here to search..."
                           FontSize="24" Foreground="#666870"
                           VerticalAlignment="Center" Margin="12,0,0,0"
                           IsHitTestVisible="False"
                           Panel.ZIndex="1" />
            </Grid>

            <Button Grid.Column="1"
                    Content="Force Rescan"
                    Command="{Binding ForceRescanCommand}"
                    IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}, FallbackValue=True}"
                    Padding="12,0" Margin="8,0,0,0"
                    Background="#007acc" Foreground="White" BorderThickness="0"
                    FontSize="13" Cursor="Hand" />
        </Grid>


        <ListView x:Name="FileListView"
                  Grid.Row="1"
                  ItemsSource="{Binding FilteredRecords}"
                  Background="#1e1e1e" Foreground="LightGray"
                  BorderBrush="#3f3f46" BorderThickness="1"
                  VirtualizingStackPanel.IsVirtualizing="True"
                  VirtualizingStackPanel.VirtualizationMode="Recycling"
                  SizeChanged="FileListView_SizeChanged">
            <ListView.View>
                <GridView>
                    <GridViewColumn x:Name="NameColumn" Header="Name" Width="260" DisplayMemberBinding="{Binding FileName}" />
                    <GridViewColumn x:Name="PathColumn" Header="Path" Width="560" DisplayMemberBinding="{Binding FullPath}" />
                </GridView>
            </ListView.View>
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="BorderThickness" Value="0" />
                    <Setter Property="Foreground" Value="LightGray" />
                    <Setter Property="Padding" Value="8,4,0,4" />

                    <Setter Property="Tag" Value="{Binding DataContext, ElementName=RootWindow}" />
                    <Setter Property="ContextMenu">
                        <Setter.Value>
                            <ContextMenu>
                                <MenuItem Header="Copy Full Path"
                                          Command="{Binding PlacementTarget.Tag.CopyPathCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                          CommandParameter="{Binding}" />
                                <MenuItem Header="Open File Location"
                                          Command="{Binding PlacementTarget.Tag.OpenLocationCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                          CommandParameter="{Binding}" />
                                <Separator />
                                <MenuItem Header="Calculate SHA256 &#38; Copy"
                                          Command="{Binding PlacementTarget.Tag.CopyHashCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                          CommandParameter="{Binding}" />
                                <MenuItem Header="Check VirusTotal"
                                          Command="{Binding PlacementTarget.Tag.CheckVirusTotalCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                          CommandParameter="{Binding}" />
                            </ContextMenu>
                        </Setter.Value>
                    </Setter>
                    <Style.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Foreground" Value="Black" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="Black" />
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </ListView.ItemContainerStyle>
        </ListView>


        <StatusBar Grid.Row="2" Background="#007acc" Foreground="White" Margin="0,10,0,0">
            <StatusBarItem>
                <TextBlock Text="{Binding StatusText}" />
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
